<Window x:Class="NightSync.Desktop.ClientConnectWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connect to cloud — NightSync" Height="360" Width="580" WindowStartupLocation="CenterOwner" Background="#F5F6FA">
<Grid Margin="28"><StackPanel><TextBlock Text="Connect to a NightSync host" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Enter the secure address provided by the cloud owner." Foreground="#626777" Margin="0,8,0,20"/><TextBlock Text="Host address" FontWeight="SemiBold"/><TextBox x:Name="HostAddress" Height="38" Margin="0,8,0,14" Padding="8" Text="https://"/><TextBlock Text="Remote connections will require HTTPS and account authentication. Never enter a password in this address field." TextWrapping="Wrap" Foreground="#626777"/><Border Background="#FFF4DB" CornerRadius="8" Padding="12" Margin="0,20,0,0"><TextBlock Text="Prototype screen: remote connection and sign-in are not implemented yet." TextWrapping="Wrap" Foreground="#74551B"/></Border><Button Content="Continue" Height="42" Margin="0,24,0,0" Click="Continue_Click"/></StackPanel></Grid></Window>
