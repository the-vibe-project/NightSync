<Window x:Class="NightSync.Desktop.HostSetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Host setup — NightSync" Height="380" Width="580" WindowStartupLocation="CenterOwner" Background="#F5F6FA">
<Grid Margin="28"><StackPanel><TextBlock Text="Set up your private cloud" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Choose where NightSync will store its data." Foreground="#626777" Margin="0,8,0,20"/><TextBlock Text="Storage folder" FontWeight="SemiBold"/><TextBox x:Name="StoragePath" Height="38" Margin="0,8,0,14" Text="D:\NightSyncData" Padding="8"/><TextBlock Text="The full setup will validate available space, permissions, encryption and recovery settings." TextWrapping="Wrap" Foreground="#626777"/><Border Background="#FFF4DB" CornerRadius="8" Padding="12" Margin="0,20,0,0"><TextBlock Text="Prototype screen: this version does not create storage or start the server yet." TextWrapping="Wrap" Foreground="#74551B"/></Border><Button Content="Continue" Height="42" Margin="0,24,0,0" Click="Continue_Click"/></StackPanel></Grid></Window>
