<Window x:Class="NightSync.Desktop.ChangePasswordWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Change temporary password" Height="430" Width="440" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#0B1220">
 <Grid Margin="28"><StackPanel VerticalAlignment="Center">
  <TextBlock Text="Change your password" FontSize="25" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
  <TextBlock Text="Your administrator issued a temporary password. Set a private password before continuing." Foreground="#B7C4D8" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <TextBlock Text="Temporary/current password" Foreground="White"/>
  <PasswordBox x:Name="CurrentBox" Height="34" Padding="7" Margin="0,5,0,12"/>
  <TextBlock Text="New password (at least 12 characters)" Foreground="White"/>
  <PasswordBox x:Name="NewBox" Height="34" Padding="7" Margin="0,5,0,12"/>
  <TextBlock Text="Confirm new password" Foreground="White"/>
  <PasswordBox x:Name="ConfirmBox" Height="34" Padding="7" Margin="0,5,0,14"/>
  <Button Content="Change password" Height="38" Click="Change_Click"/>
  <TextBlock x:Name="MessageText" Foreground="#FCD38D" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </StackPanel></Grid>
</Window>
