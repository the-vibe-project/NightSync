<Window x:Class="NightSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightSync" Height="820" Width="1260" MinHeight="700" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="#070B14">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#070B14"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#101827"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#152238"/>
    <SolidColorBrush x:Key="LineBrush" Color="#243A55"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECF7FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91A7C1"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#69E5FF"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#A48CFF"/>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#06111C"/>
      <Setter Property="Background" Value="#69E5FF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.84"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1422"/>
      <Setter Property="Foreground" Value="#ECF7FF"/>
      <Setter Property="CaretBrush" Value="#69E5FF"/>
      <Setter Property="BorderBrush" Value="#29435F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#152238"/>
      <Setter Property="Foreground" Value="#ECF7FF"/>
      <Setter Property="BorderBrush" Value="#29435F"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="#101827"/>
      <Setter Property="Foreground" Value="#B7C9DF"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="#EAF6FF"/>
      <Setter Property="Padding" Value="8,9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#1B3950"/>
          <Setter Property="Foreground" Value="#FFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C5D8ED"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="2,0,2,20">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="42" Height="42" CornerRadius="13">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#69E5FF" Offset="0"/>
              <GradientStop Color="#887BFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="N" FontSize="22" FontWeight="Bold" Foreground="#07111D"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NIGHTSYNC" Foreground="#69E5FF" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="Your private cloud" Foreground="#ECF7FF" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
          <TextBlock Text="BY THE VIBE PROJECT" Foreground="#91A7C1" FontSize="8" FontWeight="Bold" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock Text="Preview role" Foreground="#91A7C1" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="RoleSelector" Width="120" Height="30" SelectionChanged="RoleSelector_SelectionChanged" Visibility="Collapsed">
          <ComboBoxItem Content="Member" IsSelected="True"/>
          <ComboBoxItem Content="Admin"/>
        </ComboBox>
        <Border Background="#12253A" BorderBrush="#254761" BorderThickness="1" CornerRadius="18" Padding="12,8" Margin="12,0,0,0">
          <TextBlock Text="SECURE WORKSPACE" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#0D1624" BorderBrush="#1C2D43" BorderThickness="1" CornerRadius="16" Padding="13" Margin="0,0,16,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="WORKSPACE" Foreground="#617B98" FontSize="9" FontWeight="Bold" Margin="7,6,0,14"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="◈   Overview" Click="Overview_Click"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="⌁   Connect server" Click="Connect_Click"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▤   My files" Click="Files_Click"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="▧   Photos" Click="Photos_Click"/>
            <Button Style="{StaticResource NavButtonStyle}" Content="≋   Activity logs" Click="Logs_Click"/>
            <Separator Margin="5,14,5,14" Background="#263B55"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="#13243A" CornerRadius="11" Padding="12">
              <StackPanel>
                <TextBlock Text="PRIVATE BY DESIGN" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Your files stay in your own storage space." Foreground="#8FA7C1" FontSize="10"
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
              </StackPanel>
            </Border>
            <TextBlock Text="NIGHTSYNC CLIENT" Foreground="#526984" FontSize="9" FontWeight="Bold" Margin="8,15,0,4"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#0D1624" BorderBrush="#1C2D43" BorderThickness="1" CornerRadius="16" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Overview" FontSize="24" FontWeight="SemiBold" Foreground="#ECF7FF"/>
            <TextBlock x:Name="PageSubtitle" Text="Your server, storage and private workspace at a glance."
                       Foreground="#91A7C1" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,20"/>

            <StackPanel x:Name="DashboardPanel">
              <Border Background="#112A40" BorderBrush="#25506D" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,14">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="LIVE SERVER LINK" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
                    <TextBlock x:Name="LiveStatusText" Text="Not connected — connect to your NightSync server to begin."
                               Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="LiveDetailsText" Text="Live health and storage information will appear here."
                               Foreground="#A8C3DA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  </StackPanel>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#183E51" CornerRadius="12" Padding="10,7">
                    <TextBlock Text="SYNC CORE" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
                  </Border>
                </Grid>
              </Border>

              <UniformGrid Columns="2" Rows="2">
                <Border Background="#142033" BorderBrush="#243B57" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,8,8">
                  <StackPanel><TextBlock Text="STORAGE USED" Foreground="#70DFFF" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StorageUsedText" Text="—" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                </Border>
                <Border Background="#142033" BorderBrush="#243B57" BorderThickness="1" CornerRadius="11" Padding="16" Margin="8,0,0,8">
                  <StackPanel><TextBlock Text="STORAGE FREE" Foreground="#70DFFF" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="StorageFreeText" Text="—" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                </Border>
                <Border Background="#142033" BorderBrush="#243B57" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,8,8,0">
                  <StackPanel><TextBlock Text="SERVER MEMORY" Foreground="#A48CFF" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="ProcessMemoryText" Text="—" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                </Border>
                <Border Background="#142033" BorderBrush="#243B57" BorderThickness="1" CornerRadius="11" Padding="16" Margin="8,8,0,0">
                  <StackPanel><TextBlock Text="UPTIME" Foreground="#A48CFF" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="UptimeText" Text="—" Foreground="White" FontSize="21" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel>
                </Border>
              </UniformGrid>
              <TextBlock x:Name="StoragePathText" Text="Storage path: not connected" Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
              <WrapPanel Margin="0,17,0,0">
                <Button Content="Refresh status" Padding="16,9" Margin="0,0,9,0" Click="RefreshLiveStatus_Click"/>
                <Button x:Name="AdminActionButton" Content="Admin diagnostics" Padding="16,9" Background="#26364E" Foreground="#D8E8F8" Click="AdminDiagnostics_Click"/>
              </WrapPanel>
              <TextBlock x:Name="RoleNotice" Text="Member access: your private storage and server monitoring."
                         Foreground="#91A7C1" FontSize="10" Margin="0,12,0,0"/>
            </StackPanel>

            <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed">
              <Border Background="#121F32" BorderBrush="#253F5C" BorderThickness="1" CornerRadius="13" Padding="18">
                <StackPanel>
                  <TextBlock Text="Saved server profiles" Foreground="#69E5FF" FontSize="11" FontWeight="Bold"/>
                  <ComboBox x:Name="ServerProfiles" Height="34" Margin="0,8,0,15" SelectionChanged="ServerProfiles_SelectionChanged" DisplayMemberPath="Name"/>
                  <TextBlock Text="Server name" Foreground="#AFC3DA" FontSize="11"/>
                  <TextBox x:Name="ServerName" Height="36" Text="My NightSync" Margin="0,5,0,12"/>
                  <TextBlock Text="Server address" Foreground="#AFC3DA" FontSize="11"/>
                  <TextBox x:Name="ServerAddress" Height="36" Margin="0,5,0,15"/>
                  <WrapPanel>
                    <Button Content="Save profile" Padding="16,9" Margin="0,0,9,0" Click="SaveServer_Click"/>
                    <Button Content="Test connection" Padding="16,9" Background="#26364E" Foreground="#D8E8F8" Click="TestConnection_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="#ECF7FF" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,4"/>
                  <TextBlock x:Name="ConnectionDetails" Text="Use a secure HTTPS server address for remote connections."
                             Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="FilesPanel" Visibility="Collapsed">
              <Grid Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Your files" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock Text="A private space for your documents, folders and media." Foreground="#91A6C6" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#17283B" CornerRadius="20" Padding="12,7">
                  <TextBlock Text="PRIVATE STORAGE" Foreground="#66E6FF" FontSize="9" FontWeight="Bold"/>
                </Border>
              </Grid>
              <Border Background="#111D31" BorderBrush="#253C59" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                  <Button Content="‹ Back" DockPanel.Dock="Left" Padding="14,8" Margin="0,0,12,0" Click="FilesBack_Click"/>
                  <TextBlock x:Name="FilesBreadcrumb" Text="My files" Foreground="#CFE8FF" FontSize="13" VerticalAlignment="Center"/>
                  <Button Content="Refresh" DockPanel.Dock="Right" Padding="14,8" Margin="12,0,0,0" Click="RefreshFiles_Click"/>
                </DockPanel>
              </Border>
              <WrapPanel Margin="0,0,0,10">
                <Button Content="↑ Upload" Padding="14,8" Margin="0,0,8,8" Click="UploadFile_Click"/>
                <Button Content="↓ Download" Padding="14,8" Margin="0,0,8,8" Click="DownloadFile_Click"/>
                <Button Content="Delete" Padding="14,8" Background="#402638" Foreground="#FFD8E3" Margin="0,0,8,8" Click="DeleteFile_Click"/>
              </WrapPanel>
              <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <Button Content="Create folder" DockPanel.Dock="Right" Padding="13,8" Margin="10,0,0,0" Click="CreateFolder_Click"/>
                <TextBox x:Name="NewFolderName" Height="36" Padding="9" Background="#0B1422" Foreground="#EAF6FF" BorderBrush="#253C59"
                         ToolTip="Enter a name for the new folder"/>
              </DockPanel>
              <ListView x:Name="FilesList" MinHeight="330" Background="#0B1422" Foreground="#EAF6FF"
                        BorderBrush="#253C59" BorderThickness="1" MouseDoubleClick="FilesList_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                  <GridView>
                    <GridViewColumn Header="NAME" Width="280" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="TYPE" Width="95" DisplayMemberBinding="{Binding Kind}"/>
                    <GridViewColumn Header="SIZE" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="MODIFIED" Width="145" DisplayMemberBinding="{Binding ModifiedText}"/>
                  </GridView>
                </ListView.View>
              </ListView>
              <TextBlock x:Name="FilesMessage" Foreground="#91A6C6" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>

            <StackPanel x:Name="PlaceholderPanel" Visibility="Collapsed">
              <Border Background="#17283B" BorderBrush="#2B4A67" BorderThickness="1" CornerRadius="13" Padding="16">
                <TextBlock Text="This module is being prepared for a future NightSync release." Foreground="#69E5FF" TextWrapping="Wrap"/>
              </Border>
              <TextBlock x:Name="PlaceholderDetails" Foreground="#C9DBEE" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="HostPanel" Visibility="Collapsed">
              <TextBlock Text="Host controls moved to the standalone NightSync Server application." Foreground="#69E5FF"/>
              <TextBox x:Name="ServerExePathBox" Visibility="Collapsed"/>
              <TextBox x:Name="StoragePathBox" Visibility="Collapsed"/>
              <TextBox x:Name="BackupPathBox" Visibility="Collapsed"/>
              <TextBox x:Name="SyncPathBox" Visibility="Collapsed"/>
              <CheckBox x:Name="AutoStartCheck" Visibility="Collapsed"/>
              <TextBlock x:Name="HostStatusText" Visibility="Collapsed"/>
              <TextBlock x:Name="HostDetailsText" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="NIGHTSYNC  •  THE VIBE PROJECT  •  WINDOWS CLIENT" Foreground="#506782" FontSize="9" Margin="4,14,0,0"/>
  </Grid>
</Window>