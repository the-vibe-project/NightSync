<Window x:Class="NightSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightSync" Height="700" Width="1120"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <StackPanel>
        <TextBlock Text="NightSync" FontSize="30" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Your private cloud. Your storage. Your control."
                   Foreground="#AAB7CC" FontSize="14" Margin="0,6,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="#1B2B45" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
        <TextBlock Text="CLIENT MODE" Foreground="#93C5FD" FontWeight="SemiBold"/>
      </Border>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,26,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="210"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#111D31" CornerRadius="12" Padding="16" Margin="0,0,18,0">
        <StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>
          <Button Content="Overview" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Overview_Click"/>
          <Button Content="Connect to Server" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Connect_Click"/>
          <Button Content="Files" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Files_Click"/>
          <Button Content="Photos" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Photos_Click"/>
          <Button Content="Storage" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="Storage_Click"/>
          <Separator Margin="0,12,0,12" Background="#31425C"/>
          <TextBlock Text="SERVER HOST" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
          <Button Content="Set up this PC as a server" Padding="10" HorizontalContentAlignment="Left" Click="Host_Click"/>
          <TextBlock Text="Server hosting is planned for a later release."
                     Foreground="#8293AB" TextWrapping="Wrap" FontSize="11" Margin="2,8,2,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#111D31" CornerRadius="12" Padding="26">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Text="Connect to your NightSync server"
                       FontSize="24" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock x:Name="PageSubtitle"
                       Text="Save a server address now. Connection testing will work when a compatible NightSync server is online."
                       TextWrapping="Wrap" Foreground="#B7C4D8" Margin="0,10,0,20"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="SAVED SERVERS" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ComboBox x:Name="ServerProfiles" Height="34" SelectionChanged="ServerProfiles_SelectionChanged"
                        DisplayMemberPath="Name" Margin="0,0,0,16"/>
              <TextBlock Text="Server name" Foreground="#DCE6F5" Margin="0,0,0,5"/>
              <TextBox x:Name="ServerName" Height="34" Padding="8" Text="My NightSync"/>
              <TextBlock Text="Server address (HTTPS)" Foreground="#DCE6F5" Margin="0,14,0,5"/>
              <TextBox x:Name="ServerAddress" Height="34" Padding="8" ToolTip="Example: https://cloud.example.com"/>
              <WrapPanel Margin="0,16,0,18">
                <Button Content="Save server" Padding="18,9" Margin="0,0,10,0" Click="SaveServer_Click"/>
                <Button Content="Test connection" Padding="18,9" Click="TestConnection_Click"/>
              </WrapPanel>
              <Border Background="#1B2B45" CornerRadius="8" Padding="16">
                <StackPanel>
                  <TextBlock Text="CONNECTION STATUS" Foreground="#93C5FD" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="White"
                             FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/>
                  <TextBlock x:Name="ConnectionDetails"
                             Text="Add an HTTPS server address, save it, then test when your server is running."
                             Foreground="#B7C4D8" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Files, photo backup and storage browsing will be enabled after the secure server API is implemented."
                         Foreground="#8293AB" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="NightSync 0.2.0 · Client connection foundation · Development build"
               Foreground="#71829B" FontSize="11"/>
  </Grid>
</Window>
