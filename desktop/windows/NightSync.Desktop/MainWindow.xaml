<Window x:Class="NightSync.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightSync" Height="620" Width="980"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0B1220">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="NightSync" FontSize="30" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="Your private cloud. Your storage. Your control."
                 Foreground="#AAB7CC" FontSize="14" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,28,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Background="#111D31" CornerRadius="12" Padding="18" Margin="0,0,18,0">
        <StackPanel>
          <TextBlock Text="WORKSPACE" Foreground="#8FA3BF" FontSize="11" FontWeight="Bold" Margin="0,0,0,16"/>
          <Button Content="Overview" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button Content="Files" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button Content="Photos" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button Content="Storage" Padding="12" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
          <Button Content="Settings" Padding="12" HorizontalContentAlignment="Left"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#111D31" CornerRadius="12" Padding="28">
        <StackPanel>
          <TextBlock Text="Welcome to NightSync" FontSize="24" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="This is the clean Windows application scaffold. Server connection, storage, accounts and file operations will be added in later milestones."
                     TextWrapping="Wrap" Foreground="#B7C4D8" Margin="0,12,0,24" FontSize="14"/>
          <Border Background="#1B2B45" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="Development status" Foreground="#93C5FD" FontWeight="SemiBold"/>
              <TextBlock Text="UI foundation ready · Server integration pending"
                         Foreground="White" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="NightSync 0.1.0 · Free and open-source · Development build"
               Foreground="#71829B" FontSize="11"/>
  </Grid>
</Window>
