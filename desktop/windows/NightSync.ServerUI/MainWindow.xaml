<Window x:Class="NightSync.ServerUI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NightSync Server" Height="820" Width="1120" MinHeight="720" MinWidth="900"
 WindowStartupLocation="CenterScreen" Background="#0B1220">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel>
   <StackPanel>
    <TextBlock Text="NightSync Server" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"/>
    <TextBlock Text="Host dashboard · Storage · Service controls" Foreground="#AAB7CC" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#64748B" Margin="0,0,9,0"/>
    <TextBlock x:Name="StatusText" Text="Checking…" Foreground="#FFFFFF" FontSize="16" VerticalAlignment="Center"/>
   </StackPanel>
  </DockPanel>
  <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18">
   <Border Background="#15243A" CornerRadius="9" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="SERVER VERSION" Foreground="#91A5C1" FontSize="10"/><TextBlock x:Name="VersionText" Text="—" Foreground="White" FontSize="21" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Background="#15243A" CornerRadius="9" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="UPTIME" Foreground="#91A5C1" FontSize="10"/><TextBlock x:Name="UptimeText" Text="—" Foreground="White" FontSize="21" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Background="#15243A" CornerRadius="9" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="STORAGE USED" Foreground="#91A5C1" FontSize="10"/><TextBlock x:Name="UsedText" Text="—" Foreground="White" FontSize="21" Margin="0,5,0,0"/></StackPanel></Border>
   <Border Background="#15243A" CornerRadius="9" Padding="14"><StackPanel><TextBlock Text="STORAGE FREE" Foreground="#91A5C1" FontSize="10"/><TextBlock x:Name="FreeText" Text="—" Foreground="White" FontSize="21" Margin="0,5,0,0"/></StackPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,14,0">
     <Border Background="#111D31" CornerRadius="10" Padding="18" Margin="0,0,0,14">
      <StackPanel>
       <TextBlock Text="Server controls" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock Text="The server runs separately. Closing this dashboard does not stop it." Foreground="#AAB7CC" TextWrapping="Wrap" Margin="0,5,0,14"/>
       <WrapPanel>
        <Button Content="Start" Width="110" Height="36" Margin="0,0,8,8" Click="Start_Click"/>
        <Button Content="Stop" Width="110" Height="36" Margin="0,0,8,8" Click="Stop_Click"/>
        <Button Content="Restart" Width="110" Height="36" Margin="0,0,8,8" Click="Restart_Click"/>
        <Button Content="Refresh" Width="110" Height="36" Margin="0,0,8,8" Click="Refresh_Click"/>
       </WrapPanel>
       <CheckBox x:Name="AutoStartCheck" Content="Start NightSync Server when I sign in to Windows" Foreground="#EAF1FB" Margin="0,8,0,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
       <TextBlock x:Name="ControlMessage" Foreground="#FCD38D" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
     <Border Background="#111D31" CornerRadius="10" Padding="18">
      <StackPanel>
       <TextBlock Text="Storage locations" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
       <TextBlock Text="Select folders manually. Main storage is active; backup and sync paths are saved for the next implementation milestone." Foreground="#AAB7CC" TextWrapping="Wrap" Margin="0,5,0,12"/>
       <TextBlock Text="Server executable" Foreground="#DCE6F5"/>
       <DockPanel Margin="0,4,0,10"><Button Content="Browse…" DockPanel.Dock="Right" Click="BrowseExe_Click" Padding="10,5"/><TextBox x:Name="ExeBox" Height="30" Padding="6"/></DockPanel>
       <TextBlock Text="Main cloud storage" Foreground="#DCE6F5"/>
       <DockPanel Margin="0,4,0,10"><Button Content="Choose…" DockPanel.Dock="Right" Click="BrowseMain_Click" Padding="10,5"/><TextBox x:Name="MainBox" Height="30" Padding="6"/></DockPanel>
       <TextBlock Text="Backup destination (configured only)" Foreground="#DCE6F5"/>
       <DockPanel Margin="0,4,0,10"><Button Content="Choose…" DockPanel.Dock="Right" Click="BrowseBackup_Click" Padding="10,5"/><TextBox x:Name="BackupBox" Height="30" Padding="6"/></DockPanel>
       <TextBlock Text="Sync destination (configured only)" Foreground="#DCE6F5"/>
       <DockPanel Margin="0,4,0,12"><Button Content="Choose…" DockPanel.Dock="Right" Click="BrowseSync_Click" Padding="10,5"/><TextBox x:Name="SyncBox" Height="30" Padding="6"/></DockPanel>
       <Button Content="Save configuration" Height="36" HorizontalAlignment="Left" Padding="18,5" Click="Save_Click"/>
       <TextBlock x:Name="StorageMessage" Foreground="#AAB7CC" TextWrapping="Wrap" Margin="0,9,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Column="1" Background="#111D31" CornerRadius="10" Padding="18">
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Live diagnostics" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock x:Name="HealthText" Text="Waiting for local server…" Foreground="#AAB7CC" TextWrapping="Wrap" Margin="0,5,0,12"/>
      <TextBlock Text="Server log" Foreground="#DCE6F5" FontWeight="SemiBold"/>
      <Button Content="Open log file" HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,10" Click="OpenLog_Click"/>
     </StackPanel>
     <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
      Background="#080E18" Foreground="#C7D7EB" BorderThickness="0" FontFamily="Consolas" FontSize="11"/>
    </DockPanel>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" Text="NightSync 0.8.0 · Development build · Localhost only — do not expose to LAN or internet" Foreground="#71829B" FontSize="11" Margin="0,14,0,0"/>
 </Grid>
</Window>
