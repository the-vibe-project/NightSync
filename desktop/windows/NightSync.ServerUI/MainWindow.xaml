<Window x:Class="NightSync.ServerUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightSync Server" Height="790" Width="1180" MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#070B14">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#101827"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="#152238"/>
    <SolidColorBrush x:Key="LineBrush" Color="#243B57"/>
    <SolidColorBrush x:Key="TextBrush" Color="#ECF7FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91A7C1"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#69E5FF"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#A48CFF"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#69E5FF"/>
      <Setter Property="Foreground" Value="#06111C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0B1422"/>
      <Setter Property="Foreground" Value="#ECF7FF"/>
      <Setter Property="CaretBrush" Value="#69E5FF"/>
      <Setter Property="BorderBrush" Value="#29435F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="48" Height="48" CornerRadius="15">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#69E5FF" Offset="0"/>
              <GradientStop Color="#887BFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="N" Foreground="#07111D" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NIGHTSYNC  /  HOST CORE" Foreground="#69E5FF" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="Your private cloud" Foreground="#ECF7FF" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,0"/>
          <TextBlock Text="The engine that keeps your storage online." Foreground="#91A7C1" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#122238" BorderBrush="#28435F" BorderThickness="1" CornerRadius="20" Padding="15,9">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8791A0" Margin="0,0,9,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="Checking server…" Foreground="#ECF7FF" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,24,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,9,0">
        <StackPanel>
          <TextBlock Text="SERVER VERSION" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="VersionText" Text="—" Foreground="#ECF7FF" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="13" Padding="16" Margin="5,0">
        <StackPanel>
          <TextBlock Text="RUNNING TIME" Foreground="#A48CFF" FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="UptimeText" Text="—" Foreground="#ECF7FF" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="13" Padding="16" Margin="9,0,0,0">
        <StackPanel>
          <TextBlock Text="FREE STORAGE" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
          <TextBlock x:Name="FreeText" Text="—" Foreground="#ECF7FF" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0"/>
          <TextBlock x:Name="UsedText" Text="Used —" Foreground="#91A7C1" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="0.92*"/></Grid.ColumnDefinitions>

      <StackPanel Margin="0,0,9,0">
        <Border Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,13">
          <StackPanel>
            <Grid>
              <StackPanel>
                <TextBlock Text="SERVER CONTROL" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
                <TextBlock Text="Your cloud is ready when you are." Foreground="#ECF7FF" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
              </StackPanel>
              <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#182B3D" CornerRadius="14" Padding="9,6">
                <TextBlock Text="BACKGROUND ENGINE" Foreground="#69E5FF" FontSize="8" FontWeight="Bold"/>
              </Border>
            </Grid>
            <TextBlock Text="The service runs independently. Close this dashboard whenever you like." Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,14"/>
            <WrapPanel>
              <Button Content="Start" Width="100" Margin="0,0,8,8" Click="Start_Click"/>
              <Button Content="Stop" Width="85" Background="#24364C" Foreground="#D7E8F9" Margin="0,0,8,8" Click="Stop_Click"/>
              <Button Content="Restart" Width="94" Background="#24364C" Foreground="#D7E8F9" Margin="0,0,8,8" Click="Restart_Click"/>
              <Button Content="Refresh" Width="88" Background="#24364C" Foreground="#D7E8F9" Margin="0,0,8,8" Click="Refresh_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ServiceText" Text="Background service: checking…" Foreground="#A48CFF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <WrapPanel Margin="0,12,0,0">
              <Button Content="Enable background service" Padding="14,8" Margin="0,0,8,7" Click="InstallService_Click"/>
              <Button Content="Remove service" Padding="14,8" Background="#29364A" Foreground="#D7E8F9" Margin="0,0,8,7" Click="RemoveService_Click"/>
              <Button Content="Setup wizard" Padding="14,8" Background="#263049" Foreground="#D8D2FF" Margin="0,0,0,7" Click="OpenWizard_Click"/>
            </WrapPanel>
            <TextBlock x:Name="ControlMessage" Foreground="#69E5FF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>

        <Border Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="14" Padding="18">
          <StackPanel>
            <TextBlock Text="STORAGE SETTINGS" Foreground="#A48CFF" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="Choose where your cloud files live." Foreground="#ECF7FF" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="Main storage is active. Backup and sync destinations are saved for later features." Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/>
            <TextBlock Text="Main storage folder" Foreground="#BED0E5" FontSize="10"/>
            <DockPanel Margin="0,5,0,11">
              <Button Content="Browse…" DockPanel.Dock="Right" Padding="12,7" Margin="8,0,0,0" Click="BrowseMain_Click"/>
              <TextBox x:Name="MainBox" Height="35" VerticalContentAlignment="Center"/>
            </DockPanel>
            <Expander Header="Advanced destinations" Foreground="#69E5FF" FontSize="11" IsExpanded="False">
              <StackPanel Margin="0,10,0,0">
                <TextBlock Text="Backup destination (not active yet)" Foreground="#91A7C1" FontSize="10"/>
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" DockPanel.Dock="Right" Padding="12,7" Margin="8,0,0,0" Click="BrowseBackup_Click"/>
                  <TextBox x:Name="BackupBox" Height="35" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Sync destination (not active yet)" Foreground="#91A7C1" FontSize="10"/>
                <DockPanel Margin="0,5,0,10">
                  <Button Content="Browse…" DockPanel.Dock="Right" Padding="12,7" Margin="8,0,0,0" Click="BrowseSync_Click"/>
                  <TextBox x:Name="SyncBox" Height="35" VerticalContentAlignment="Center"/>
                </DockPanel>
              </StackPanel>
            </Expander>
            <Button Content="Save storage settings" HorizontalAlignment="Left" Padding="15,8" Margin="0,12,0,0" Click="Save_Click"/>
            <TextBlock x:Name="StorageMessage" Foreground="#91A7C1" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Background="#101827" BorderBrush="#243B57" BorderThickness="1" CornerRadius="14" Padding="18" Margin="9,0,0,0">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="SYSTEM MONITOR" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="Live activity" Foreground="#ECF7FF" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock x:Name="HealthText" Text="Checking your server…" Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,15"/>
            <Grid Margin="0,0,0,12">
              <TextBlock Text="Recent events" Foreground="#CFE2F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="Open full log" HorizontalAlignment="Right" Background="#24364C" Foreground="#D7E8F9" Padding="11,7" Click="OpenLog_Click"/>
            </Grid>
          </StackPanel>
          <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                   Background="#09121E" Foreground="#A8C6DF" BorderThickness="0"
                   FontFamily="Consolas" FontSize="10" Padding="12"/>
        </DockPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Text="NIGHTSYNC SERVER  •  DEVELOPMENT BUILD  •  LOCAL HOST" Foreground="#506782" FontSize="9" Margin="2,15,0,0"/>
  </Grid>
</Window>