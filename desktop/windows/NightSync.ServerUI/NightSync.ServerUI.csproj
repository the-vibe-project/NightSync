<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NightSync.Server</AssemblyName>
    <Version>0.9.0</Version>
    <RootNamespace>NightSync.ServerUI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\NightSync.Server.Engine.exe"
                      LogicalName="NightSync.Server.Engine.exe"
                      Condition="Exists('Resources\NightSync.Server.Engine.exe')" />
  </ItemGroup>
</Project>