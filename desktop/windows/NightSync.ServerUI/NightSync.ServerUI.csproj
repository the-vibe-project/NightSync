<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NightSync.Server</AssemblyName>
    <Version>0.9.0</Version>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>0.9.0.0</FileVersion>
    <Company>The Vibe Project</Company>
    <Product>NightSync Server</Product>
    <Description>Private cloud server by The Vibe Project</Description>
    <Copyright>Copyright © 2026 The Vibe Project</Copyright>
    <RootNamespace>NightSync.ServerUI</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\NightSync.Server.Engine.exe"
                      LogicalName="NightSync.Server.Engine.exe"
                      Condition="Exists('Resources\NightSync.Server.Engine.exe')" />
  </ItemGroup>
</Project>