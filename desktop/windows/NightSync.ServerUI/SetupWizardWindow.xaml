<Window x:Class="NightSync.ServerUI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NightSync Setup" Height="590" Width="760" MinHeight="550" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#070B14">
  <Window.Resources>
    <SolidColorBrush x:Key="TextBrush" Color="#ECF7FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91A7C1"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#101B2B"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#69E5FF"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#69E5FF"/>
      <Setter Property="Foreground" Value="#06111C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#0A1422"/>
      <Setter Property="Foreground" Value="#ECF7FF"/>
      <Setter Property="BorderBrush" Value="#28415E"/>
      <Setter Property="Padding" Value="11,9"/>
      <Setter Property="CaretBrush" Value="#69E5FF"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8E7F7"/><Setter Property="FontSize" Value="13"/></Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal">
        <Border Width="42" Height="42" CornerRadius="13">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#69E5FF"/><GradientStop Color="#887BFF" Offset="1"/></LinearGradientBrush></Border.Background>
          <TextBlock Text="N" Foreground="#07111D" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NIGHTSYNC" Foreground="#69E5FF" FontSize="10" FontWeight="Bold"/>
          <TextBlock Text="Setup wizard" Foreground="#ECF7FF" FontSize="21" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>
      <TextBlock x:Name="StepText" Text="STEP 01 / 03" Foreground="#91A7C1" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,26,0,22">
      <StackPanel x:Name="WelcomePanel" Visibility="Visible" VerticalAlignment="Center">
        <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Left" Margin="0,0,0,24">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#173B55"/><GradientStop Color="#24204A" Offset="1"/></LinearGradientBrush></Border.Background>
          <TextBlock Text="✦" Foreground="#69E5FF" FontSize="39" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Your own cloud.&#x0a;Ready when you are." Foreground="#ECF7FF" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="We’ll prepare this PC as your private NightSync host. Your server will run quietly in the background and start with Windows, even before you sign in." Foreground="#A7BCD3" FontSize="14" TextWrapping="Wrap" LineHeight="22" Margin="0,16,70,0"/>
        <Border Background="#101B2B" BorderBrush="#233D58" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,26,0,0">
          <StackPanel>
            <TextBlock Text="WHAT WE’LL SET UP" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="01   Choose the main storage folder" Foreground="#DCEBFA" FontSize="12" Margin="0,10,0,0"/>
            <TextBlock Text="02   Install the background service" Foreground="#DCEBFA" FontSize="12" Margin="0,8,0,0"/>
            <TextBlock Text="03   Start NightSync and verify it is online" Foreground="#DCEBFA" FontSize="12" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="StoragePanel" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock Text="Choose your cloud storage" Foreground="#ECF7FF" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="This is where files from your private NightSync accounts will be stored. Choose a folder on a drive with enough space." Foreground="#91A7C1" FontSize="13" TextWrapping="Wrap" Margin="0,10,50,22"/>
        <TextBlock Text="MAIN STORAGE LOCATION" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
        <DockPanel Margin="0,8,0,0">
          <Button Content="Browse…" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Browse_Click"/>
          <TextBox x:Name="StoragePathBox" Height="42" VerticalContentAlignment="Center"/>
        </DockPanel>
        <Border Background="#101B2B" BorderBrush="#233D58" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,22,0,0">
          <StackPanel>
            <TextBlock Text="YOUR DATA STAYS IN THIS FOLDER" Foreground="#69E5FF" FontSize="9" FontWeight="Bold"/>
            <TextBlock Text="NightSync does not format drives or delete existing files during setup. You can change this location later from the Server dashboard." Foreground="#A7BCD3" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="BackgroundPanel" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock Text="Always-on background service" Foreground="#ECF7FF" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="NightSync can start as Windows boots. The service runs separately from this dashboard, so the cloud stays online when you close the app or sign out." Foreground="#91A7C1" FontSize="13" TextWrapping="Wrap" Margin="0,10,45,22"/>
        <Border Background="#101B2B" BorderBrush="#233D58" BorderThickness="1" CornerRadius="14" Padding="18">
          <StackPanel>
            <CheckBox x:Name="BackgroundServiceCheck" IsChecked="True" Content="Start NightSync automatically with Windows" FontWeight="SemiBold"/>
            <TextBlock Text="Runs before sign-in · Starts in the background · Restarts after an unexpected failure" Foreground="#91A7C1" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="#2A2418" BorderBrush="#5D4C2B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,17,0,0">
          <TextBlock Text="Windows will ask for administrator approval to install the service. NightSync needs permission to access the storage folder you selected." Foreground="#EBD7A7" FontSize="11" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Rectangle Width="52" Height="3" Fill="#69E5FF" RadiusX="2" RadiusY="2" Margin="0,0,5,0"/>
        <Rectangle x:Name="ProgressTwo" Width="52" Height="3" Fill="#26394F" RadiusX="2" RadiusY="2" Margin="0,0,5,0"/>
        <Rectangle x:Name="ProgressThree" Width="52" Height="3" Fill="#26394F" RadiusX="2" RadiusY="2"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="Back" Background="#1A2A3D" Foreground="#CFE2F5" Margin="0,0,8,0" Click="Back_Click" Visibility="Collapsed"/>
        <Button x:Name="ContinueButton" Content="Continue" MinWidth="124" Click="Continue_Click"/>
        <Button x:Name="FinishButton" Content="Finish setup" MinWidth="124" Click="Finish_Click" Visibility="Collapsed"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>